* text=auto eol=lf

# Keep scripts and source files consistently LF across platforms.
*.sh text eol=lf
*.py text eol=lf
*.cpp text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
Makefile text eol=lf

# Binary assets: never normalize
*.tar.gz binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
