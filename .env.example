# Copy to .env and export variables in your shell before running the interceptor.
# (test_run.sh sets HONEYPOT_VSOCK_UDS internally; override there if you fork scripts.)

# Firecracker vsock UDS base (no _PORT suffix). Must match infra/03_run_vm.sh.
HONEYPOT_VSOCK_UDS=/tmp/honeypot-fc-vsock

# Local Ollama (same machine / same WSL session as interceptor.py)
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=llama3.2

# Optional: write telemetry somewhere else (default: honeypot-project/logs/telemetry.json)
# HONEYPOT_TELEMETRY_PATH=
